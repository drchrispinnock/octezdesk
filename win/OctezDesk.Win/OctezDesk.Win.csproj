<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\common\OctezDesk.Core\OctezDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OctezDesk.ico" />
    <Resource Include="Assets\icon-256.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The release script passes -p:Version; Velopack's package version must match it. -->
    <Version>0.2.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>OctezDesk.Win.Program</StartupObject>
    <!-- Made from spec/icon.png; see Assets/README.md -->
    <ApplicationIcon>Assets\OctezDesk.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent theme) is marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

</Project>
