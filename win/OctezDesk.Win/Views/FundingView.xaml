<UserControl x:Class="OctezDesk.Win.Views.FundingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OctezDesk.Win.Views">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back" MinWidth="96" Command="{Binding BackCommand}" />
                    <Button Content="Next" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding NextCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding Errors}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:WizardSteps Current="4" />
                <TextBlock Style="{StaticResource PageTitle}" Text="Funds" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="A baker needs at least 6,000 ꜩ staked to get baking rights. On a test network, OctezDesk can get them from the faucet." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="{Binding FundLabel}" FontWeight="SemiBold" IsChecked="{Binding Fund}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" Text="{Binding FundHint}" />
                        <StackPanel Orientation="Horizontal" Margin="28,12,0,0" IsEnabled="{Binding Fund}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount" />
                            <TextBox Width="110" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="8,6,0,6" Text="ꜩ (at least 6,001)" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="28,6,0,0" Text="{Binding FaucetLimit}"
                                   Visibility="{Binding FaucetLimit, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding Fund}">
                    <StackPanel>
                        <CheckBox Content="{Binding StakeLabel}" FontWeight="SemiBold" IsChecked="{Binding Stake}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" Text="{Binding StakeHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
