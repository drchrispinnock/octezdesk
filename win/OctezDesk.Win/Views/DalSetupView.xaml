<UserControl x:Class="OctezDesk.Win.Views.DalSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OctezDesk.Win.Views">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back" MinWidth="96" Command="{Binding BackCommand}" />
                    <Button Content="Set up" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding SetUpCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding Errors}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:WizardSteps Current="5" />
                <TextBlock Style="{StaticResource PageTitle}" Text="DAL node" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="The DAL node takes part in Tezos's data-availability layer. Bakers need one to attest DAL data and earn the DAL rewards." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Run a DAL node" FontWeight="SemiBold" IsChecked="{Binding Enabled}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0"
                                   Text="Installs octez-dal-node (about 640 MB to download) and runs it next to your node." />
                        <TextBlock Style="{StaticResource ErrorText}" Margin="28,8,0,0" Text="{Binding Warning}"
                                   Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" IsEnabled="{Binding Enabled}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attester" VerticalAlignment="Top" />
                        <TextBox Grid.Column="1" Grid.ColumnSpan="3" FontFamily="Cascadia Mono, Consolas"
                                 Text="{Binding AttesterAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding AsksForAttester, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,4,0,14"
                                   Text="{Binding AttesterHint}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="P2P port" />
                        <TextBox Grid.Row="2" Grid.Column="1" Width="90" Text="{Binding P2pPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="24,6,16,6" Text="RPC port" />
                        <TextBox Grid.Row="2" Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding RpcPort, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
