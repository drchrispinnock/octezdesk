<UserControl x:Class="OctezDesk.Win.Views.SetupProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" />
            <Button Content="Retry" Command="{Binding RetryCommand}" />
            <Button Content="Continue" IsDefault="True" Command="{Binding ContinueCommand}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Setting up your node" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Status}" />
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="22" Text="{Binding Glyph}" />
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock Margin="22,0,0,0" Foreground="Firebrick" TextWrapping="Wrap" Text="{Binding Error}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox Style="{StaticResource LogList}" ItemsSource="{Binding Log.Lines}" />
    </DockPanel>
</UserControl>
