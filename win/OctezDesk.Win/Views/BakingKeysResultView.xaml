<UserControl x:Class="OctezDesk.Win.Views.BakingKeysResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- A label, the value in a read-only box (selectable, and wraps long keys), and a Copy button -->
        <DataTemplate x:Key="FieldRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Text="{Binding Label}" />
                <TextBox Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Text="{Binding Value, Mode=OneWay}" />
                <Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Top" Content="Copy"
                        Command="{Binding DataContext.CopyCommand, ElementName=Root}" CommandParameter="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Continue" MinWidth="96" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" Command="{Binding ContinueCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Your baking keys" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="These keys are in the Octez wallet inside the OctezDesk distro. Only public data is shown here; the secret keys never leave the distro." />

                <ItemsControl ItemsSource="{Binding Keys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldRow}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Next steps" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding NextStepsIntro}" />
                        <!-- Master key: its on-chain state, and registration from here -->
                        <ItemsControl ItemsSource="{Binding Status}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,2" Text="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding HasMasterKey, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="Register as baker" Style="{DynamicResource AccentButtonStyle}" Command="{Binding RegisterCommand}"
                                    Visibility="{Binding CanRegister, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <!-- Unstake from the master key, and withdraw once it's released -->
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding CanUnstake, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,6" Text="Unstake" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="120" Text="{Binding UnstakeAmount, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UnstakeEverything, Converter={StaticResource InverseBool}}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="8,6,16,6" Text="ꜩ" />
                                <CheckBox Content="Everything" VerticalAlignment="Center" IsChecked="{Binding UnstakeEverything}" />
                                <Button Content="Unstake" Margin="16,0,0,0" Command="{Binding UnstakeCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding UnstakeHint}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Left" Margin="0,12,0,0" Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding FinalizeLabel}" Command="{Binding FinalizeUnstakeCommand}"
                                Visibility="{Binding CanFinalize, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Moves tez that have finished unstaking to the spendable balance (octez-client finalize unstake)." />
                        <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding Errors}"
                                   Visibility="{Binding Errors, Converter={StaticResource NullToCollapsed}}" />
                        <!-- Consensus key: commands to run from the wallet holding the master key -->
                        <ItemsControl ItemsSource="{Binding NextSteps}" ItemTemplate="{StaticResource FieldRow}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
