<UserControl x:Class="OctezDesk.Win.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Top">
                <MenuItem Header="☰" FontSize="18" ToolTip="Menu">
                    <MenuItem Header="Upgrade" Command="{Binding UpgradeCommand}" />
                    <MenuItem Header="Reconfigure" Command="{Binding ReconfigureCommand}" ToolTip="Coming soon" />
                    <MenuItem Header="Restart node" Command="{Binding RestartCommand}" />
                    <Separator />
                    <MenuItem Header="Shut down node" Command="{Binding ShutdownCommand}" />
                    <Separator />
                    <MenuItem Header="Keep node running after sign-in" IsCheckable="True"
                              IsChecked="{Binding StartAtSignIn}"
                              ToolTip="Starts the OctezDesk background helper when you sign in to Windows, so the node runs after a reboot." />
                    <MenuItem Header="Exit OctezDesk" Command="{Binding ExitCommand}"
                              ToolTip="Closes this window. The node keeps running." />
                </MenuItem>
            </Menu>
            <TextBlock Style="{StaticResource PageTitle}" Margin="0" Text="OctezDesk" />
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Node" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding NodeSummary}" />
                <TextBlock Foreground="Gray" Text="{Binding NodeDetails}" />
            </StackPanel>
            <Ellipse Grid.Column="2" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                     Fill="{Binding NodeLevel, Converter={StaticResource HealthBrush}}" />
        </Grid>
        <!-- DAL node and baker rows come with later objectives. -->

        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"
                   Text="The node keeps running in the background when you close OctezDesk (until you sign out, unless 'Keep node running after sign-in' is on)." TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8" Text="{Binding BusyText}" />
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Logs" Margin="0,8,0,4" />
        <ListBox Style="{StaticResource LogList}" ItemsSource="{Binding Log.Lines}" />
    </DockPanel>
</UserControl>
