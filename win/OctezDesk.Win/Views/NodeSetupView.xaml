<UserControl x:Class="OctezDesk.Win.Views.NodeSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OctezDesk.Win.Views">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Back" MinWidth="96" Command="{Binding BackCommand}" />
                    <Button Content="Next" MinWidth="96" Margin="8,0,0,0" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding SetUpCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding Errors}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <views:WizardSteps Current="2" />
                <TextBlock Style="{StaticResource PageTitle}" Text="Node" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Choose the network and how much history to keep. The defaults suit most people." />

                <!-- Network -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Network" />
                        <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Networks}" SelectedItem="{Binding Network}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,12" Text="{Binding NetworkHint}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="History mode" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding HistoryModes}" SelectedItem="{Binding HistoryMode}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding HistoryModeHint}" />
                    </Grid>
                </Border>

                <!-- Ports -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Gossip port" />
                        <TextBox Grid.Column="1" Width="90" Text="{Binding P2pPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Margin="24,6,16,6" Text="RPC port" />
                        <TextBox Grid.Column="3" Width="90" HorizontalAlignment="Left" Text="{Binding RpcPort, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                  Content="Enable all RPC calls (--allow-all-rpc)" IsChecked="{Binding AllowAllRpc}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="28,0,0,0"
                                   Text="Only needed if other software, such as a baker or indexer, uses this node's RPC. The RPC only listens on this PC." />
                    </Grid>
                </Border>

                <!-- Data -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Column="1" Grid.ColumnSpan="2" Content="Start from a snapshot (recommended)"
                                  IsChecked="{Binding ImportSnapshot}" IsEnabled="{Binding CanImportSnapshot}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="28,0,0,12"
                                   Text="{Binding SnapshotHint}" />

                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Data location" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InstallLocation, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Content="Browse…" Command="{Binding BrowseCommand}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{Binding FreeSpace}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                                   Text="{Binding SpaceWarning}" Visibility="{Binding SpaceWarning, Converter={StaticResource NullToCollapsed}}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
