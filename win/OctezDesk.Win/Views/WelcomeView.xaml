<UserControl x:Class="OctezDesk.Win.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Next" IsDefault="True" Command="{Binding NextCommand}" />
        </StackPanel>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Welcome to OctezDesk" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="This wizard sets up an Octez node for Tezos on this PC. You will choose a network and a few settings; OctezDesk then installs Octez, imports a snapshot and starts the node." />
            <TextBlock TextWrapping="Wrap" Text="{Binding Status}" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding NeedsWsl, Converter={StaticResource BoolToVisibility}}">
                <Button Margin="0" Content="Install WSL…" Command="{Binding InstallWslCommand}" />
                <Button Content="Check again" Command="{Binding CheckCommand}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
