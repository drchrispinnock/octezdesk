<Application x:Class="OctezDesk.Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OctezDesk.Win.ViewModels"
             xmlns:views="clr-namespace:OctezDesk.Win.Views"
             xmlns:local="clr-namespace:OctezDesk.Win"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <!-- ThemeMode="System": WPF's Windows 11 (Fluent) theme, following the system light/dark setting.
         Colours below use the theme's brushes via DynamicResource so both modes work. -->
    <Application.Resources>
        <!-- Each page view model is rendered by its view -->
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><views:WelcomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NodeSetupViewModel}"><views:NodeSetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BakingKeysViewModel}"><views:BakingKeysView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FundingViewModel}"><views:FundingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DalSetupViewModel}"><views:DalSetupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupProgressViewModel}"><views:SetupProgressView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BakingKeysResultViewModel}"><views:BakingKeysResultView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>

        <local:HealthBrushConverter x:Key="HealthBrush" />
        <local:StepStatusBrushConverter x:Key="StepBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:KeyTypeLabelConverter x:Key="KeyTypeLabel" />

        <!-- App icon (spec/icon.png, resized; the window and exe use Assets/OctezDesk.ico) -->
        <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/icon-256.png" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,16,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Bottom bar holding Back / Next style buttons on every page -->
        <Style x:Key="Footer" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,14,0,0" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="LogList" TargetType="ListBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="local:AutoScroll.Enabled" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
